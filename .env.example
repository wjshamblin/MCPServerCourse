# Step 08 — Minimal Azure AD Auth Demo (Confidential Client)
#
# 1. Register an app in Azure Portal → App Registrations → New registration.
#    Choose "Web" platform with redirect URI:
#      http://localhost:8000/callback   (must match SERVER_BASE_URL + /callback)
# 2. Under "Certificates & secrets" create a new client secret (copy the *value*,
#    not the secret ID).
# 3. Under "Expose an API" set an Application ID URI (defaults to api://<client_id>)
#    and add a scope named `access_as_user`.
# 4. Copy this file to .env and fill in:

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Custom scope name you defined under "Expose an API"
AZURE_API_SCOPE=access_as_user

# Public URL of this server (used for the OAuth callback). Must match the
# redirect URI you registered in Azure.
SERVER_BASE_URL=http://localhost:8000

# Additional OAuth scopes requested alongside your custom scope.
ADDITIONAL_AUTH_SCOPES=email,openid,profile,offline_access
