# Step 09 — Minimal Azure Public Client + PKCE + Security
#
# Set up the Azure app registration like step 08, BUT under "Authentication"
# add a "Mobile and desktop applications" platform and enable "Allow public
# client flows". Redirect URI:  http://localhost:8000/callback
#
# A confidential client secret is NOT required — PKCE proves the request
# came from the same client that started the flow.

AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Custom scope name from "Expose an API"
AZURE_API_SCOPE=access_as_user

SERVER_BASE_URL=http://localhost:8000
ADDITIONAL_AUTH_SCOPES=email,openid,profile,offline_access

# Comma-separated emails allowed to call privileged_action(). Empty = allow
# any authenticated user (the WARNING in the logs reminds you).
ALLOWED_USERS=

# Where the hash-chained audit log is written. One JSONL file per month.
AUDIT_LOG_DIR=logs

# Required when using a public client (no upstream client secret) — FastMCP
# needs an explicit signing key for the tokens it issues to MCP clients.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SIGNING_KEY=
