# Step 10 — Minimal Azure Public Client + PKCE + Security
#
# Set up the Azure app registration like step 09, BUT under "Authentication":
#   - Add a "Mobile and desktop applications" platform
#   - Set the redirect URI to:   http://localhost:8000/auth/callback
#     (this is AzureProvider's default redirect path)
#   - Under "Advanced settings" → "Allow public client flows" → Yes
#
# A confidential client secret is NOT required — PKCE proves the request
# came from the same client that started the flow.
#
# Reference: https://gofastmcp.com/integrations/azure#azure-microsoft-entra-id-oauth--fastmcp

AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Custom scope name from "Expose an API" (UNPREFIXED — AzureProvider
# auto-prefixes with `api://<AZURE_CLIENT_ID>/`).
AZURE_API_SCOPE=access_as_user

# Optional, comma-separated Microsoft Graph scopes (fully-qualified URIs).
# e.g. AZURE_GRAPH_SCOPES=https://graph.microsoft.com/User.Read
AZURE_GRAPH_SCOPES=

SERVER_BASE_URL=http://localhost:8000

# Comma-separated emails allowed to call privileged_action(). Empty = allow
# any authenticated user (the WARNING in the logs reminds you).
ALLOWED_USERS=

# Where the hash-chained audit log is written. One JSONL file per month.
AUDIT_LOG_DIR=logs

# REQUIRED in public-client mode: FastMCP needs an explicit signing key
# for the tokens it issues to MCP clients (normally derived from the
# upstream client secret, which we no longer have).
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SIGNING_KEY=
