# Step 11 — Directory MCP Server with Azure AD On-Behalf-Of (OBO)
#
# Azure App Registration setup (one app, configured for OBO):
#   1. App registrations → New registration. "Web" platform.
#      Redirect URI: http://localhost:8000/auth/callback
#      (this is AzureProvider's default redirect path)
#   2. Certificates & secrets → New client secret (copy the *value*).
#      OBO requires a confidential client — a secret is mandatory.
#   3. Expose an API → set Application ID URI api://<client_id>; add scope
#      "access_as_user".
#   4. Manifest → set  "requestedAccessTokenVersion": 2
#   5. API permissions → Microsoft Graph (Delegated):
#        - User.Read.All
#        - Directory.Read.All
#      Then click "Grant admin consent". Without admin consent, OBO fails
#      with AADSTS65001.
#
# Reference: https://gofastmcp.com/integrations/azure#on-behalf-of-obo

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Custom scope name from "Expose an API" (UNPREFIXED — AzureProvider
# auto-prefixes with `api://<AZURE_CLIENT_ID>/`).
AZURE_API_SCOPE=access_as_user

SERVER_BASE_URL=http://localhost:8000

# Graph API scopes the OBO exchange will request on the user's behalf.
# Must be a subset of the Microsoft Graph delegated permissions granted
# above — and these are the exact scopes `EntraOBOToken([...])` asks for
# in each tool. Space- or comma-separated. Same name as steps 09/10.
AZURE_GRAPH_SCOPES=https://graph.microsoft.com/User.Read.All https://graph.microsoft.com/Directory.Read.All
GRAPH_BASE_URL=https://graph.microsoft.com/beta
