# Step 07 — Duke OIDC Auth Demo
#
# Register an OAuth client at:
#   https://authentication.oit.duke.edu/manager/oauth/register
#
# The redirect URI you register MUST match SERVER_BASE_URL + /callback,
# e.g.  http://localhost:8000/callback

OIDC_WELL_KNOWN_URL=https://oauth.oit.duke.edu/oidc/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile offline_access
SERVER_BASE_URL=http://localhost:8000
