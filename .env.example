# Step 10 — Directory MCP Server with Azure AD On-Behalf-Of (OBO)
#
# Azure App Registration setup (one app, configured for OBO):
#   1. App registrations → New registration. "Web" platform.
#      Redirect URI: http://localhost:8000/callback
#   2. Certificates & secrets → New client secret (copy the *value*).
#   3. Expose an API → set Application ID URI api://<client_id>; add scope
#      "access_as_user".
#   4. API permissions → Microsoft Graph (Delegated):
#        - User.Read.All
#        - Directory.Read.All
#      Then click "Grant admin consent".
#   5. Authentication → Advanced settings → enable "Allow public client
#      flows" if you also want PKCE-friendly clients to authenticate, BUT
#      keep the client secret because OBO requires it.

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

AZURE_API_SCOPE=access_as_user
SERVER_BASE_URL=http://localhost:8000
ADDITIONAL_AUTH_SCOPES=email,openid,profile,offline_access

# Graph API scopes the OBO exchange will request on the user's behalf.
GRAPH_SCOPES=https://graph.microsoft.com/User.Read.All https://graph.microsoft.com/Directory.Read.All
GRAPH_BASE_URL=https://graph.microsoft.com/beta

# OBO-issued tokens are cached per (incoming_token_hash, scope) so a single
# logical request that fans out to several Graph calls only does one
# upstream exchange. Set in seconds.
OBO_TOKEN_CACHE_TTL=3000
