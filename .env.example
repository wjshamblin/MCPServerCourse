# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DATABASE_PATH=data/university_gl.db
MAX_ROWS=2000
WARNING_ROWS=100
LOG_LEVEL=INFO

# LLM Configuration
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Or:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o

# Azure OAuth (leave blank to disable auth)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
MCP_API_SCOPE=access_as_user
OAUTH_BASE_URL=http://localhost:8000
ADDITIONAL_AUTH_SCOPES=email,openid,profile,offline_access

# Access Control (comma-separated emails, empty = allow all authenticated)
ALLOWED_USERS=

# Audit Logging
AUDIT_LOG_DIR=logs
