# Financial MCP Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DATABASE_PATH=data/university_gl.db
MAX_ROWS=2000
WARNING_ROWS=100
LOG_LEVEL=INFO

# LLM Configuration (for NL-to-SQL)
# Set one of these:
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Or:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o
